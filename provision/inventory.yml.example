all:
  vars:
    # Cloud-init provisioning vars (used by flash.nu on the flashing host).
    # MWireless and the operator hotspot use DHCP for development access.
    wifi:
      umich:
        identity: uniqname@umich.edu
        password: password
      hotspot:
        ssid: Recover.Me-XXXX
        password: change-this-hotspot-password
      field:
        ssid: MAAV-Fleet
        password: change-this-field-password
        channel: 6
        dhcp:
          start: 10.77.0.100
          end: 10.77.0.199
          lease_time: 12h
          # These leases are for operator devices. Drones use fleet_ip.
          static_leases:
            - mac: "02:00:00:00:00:01"
              ip: 10.77.0.50
              hostname: operator-laptop
    maav_password_hash: ""
    ssh_authorized_keys: [""]
    # Reusable, tagged pre-auth key from https://login.tailscale.com/admin/settings/keys
    # Leave empty to skip Tailscale authentication at flash time.
    tailscale_authkey: ""
    # Reserve .10 through .19 for companion computers. Known hosts use
    # .10 + fleet_index; unused slots remain available for replacement Pis.
    fleet_dds:
      domain_id: 0
      interface: wlan0
      subnet: 10.77.0.0/24
      peers:
        - 10.77.0.10
        - 10.77.0.11
        - 10.77.0.12
        - 10.77.0.13
        - 10.77.0.14
        - 10.77.0.15
        - 10.77.0.16
        - 10.77.0.17
        - 10.77.0.18
        - 10.77.0.19
  children:
    drones:
      hosts:
        bigpi5:
        drone0:
        drone1:
        drone2:
        drone3:
        drone4:
      vars:
        ansible_user: maav
        # Tailscale MagicDNS resolves hostnames automatically.
        # If not enabled, add per-host ansible_host overrides.
    qualifier_fleet:
      hosts:
        drone0:
          fleet_index: 0
          vehicle_namespace: px4_0
          fleet_ip: 10.77.0.10
        drone1:
          fleet_index: 1
          vehicle_namespace: px4_1
          fleet_ip: 10.77.0.11
        drone3:
          fleet_index: 3
          vehicle_namespace: px4_3
          fleet_ip: 10.77.0.13
        drone4:
          fleet_index: 4
          vehicle_namespace: px4_4
          fleet_ip: 10.77.0.14
