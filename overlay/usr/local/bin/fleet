#!/bin/bash
set -euo pipefail

readonly CONTROLLER="${FLEET_NETWORK_TOOL:-/usr/local/sbin/fleet-network}"
readonly CONFIG_FILE="${FLEET_CONFIG_FILE:-/etc/maav/fleet-network.conf}"
readonly MODE_FILE="${FLEET_MODE_FILE:-/var/lib/maav/fleet-mode}"
readonly ROS_SETUP="${FLEET_ROS_SETUP:-/opt/ros/jazzy/setup.bash}"
readonly MISSION_SETUP="${FLEET_MISSION_SETUP:-/home/maav/mission10/install/setup.bash}"

usage() {
    cat >&2 <<'EOF'
usage: fleet status
       fleet MASTER field|internet
       fleet local MASTER field|internet
EOF
}

config_value() {
    sed -n "s/^$1=//p" "$CONFIG_FILE"
}

mode_value() {
    sed -n "s/^$1=//p" "$MODE_FILE" 2>/dev/null || true
}

device_status() {
    local address
    local connection
    local device="$1"
    local state

    state="$(nmcli -g GENERAL.STATE device show "$device" 2>/dev/null || true)"
    if [[ -z "$state" ]]; then
        printf '%s: absent\n' "$device"
        return
    fi
    connection="$(nmcli -g GENERAL.CONNECTION device show "$device" 2>/dev/null || true)"
    address="$(nmcli -g IP4.ADDRESS device show "$device" 2>/dev/null | paste -sd, - || true)"
    printf '%s: %s; connection=%s; ipv4=%s\n' \
        "$device" "$state" "${connection:---}" "${address:---}"
}

service_status() {
    local service="$1"
    local state

    state="$(systemctl is-active "$service" 2>/dev/null || true)"
    printf '%s: %s\n' "$service" "${state:-unknown}"
}

broadcast_mode() {
    local index
    local master="$1"
    local network="$2"
    local network_id

    "$CONTROLLER" check >/dev/null
    [[ "$master" =~ ^[0-9]{1,3}$ ]] && ((10#$master <= 255)) || {
        echo "fleet: MASTER must be 0..255" >&2
        return 2
    }
    case "$network" in
        field) network_id=0 ;;
        internet) network_id=1 ;;
        *) echo "fleet: network must be field or internet" >&2; return 2 ;;
    esac
    systemctl is-active --quiet uwb-gateway.service || {
        echo "fleet: uwb-gateway.service is not active; use 'fleet local' for recovery" >&2
        return 1
    }
    index="$(config_value FLEET_INDEX)"
    # The gateway sends the UWB frame and applies the same selection locally.
    # This is required because a radio does not receive its own broadcast.
    set +u
    source "$ROS_SETUP"
    source "$MISSION_SETUP"
    set -u
    ros2 service call "/px4_$index/uwb/set_fleet_mode" \
        flight_interfaces/srv/SetFleetMode \
        "{master_id: $master, network: $network_id}"
}

show_status() {
    local fleet_index
    local master
    local network
    local role

    fleet_index="$(config_value FLEET_INDEX)"
    if [[ -e "$MODE_FILE" ]]; then
        master="$(mode_value MASTER)"
        network="$(mode_value NETWORK)"
    else
        master="none"
        network="internet"
    fi
    if [[ "$master" == none ]]; then
        role="unselected"
    elif [[ "$master" == "$fleet_index" ]]; then
        role="master"
    else
        role="follower"
    fi

    printf 'fleet: index=%s master=%s network=%s role=%s\n' \
        "$fleet_index" "$master" "$network" "$role"
    device_status wlan0
    device_status wlan1
    service_status fleet-network.service
    service_status fleet-dhcp.service
    service_status uwb-gateway.service
}

case "${1:-}" in
    status)
        (($# == 1)) || { usage; exit 2; }
        show_status
        ;;
    local)
        (($# == 3)) || { usage; exit 2; }
        if ((EUID == 0)); then
            exec "$CONTROLLER" set-mode "$2" "$3"
        fi
        exec sudo "$CONTROLLER" set-mode "$2" "$3"
        ;;
    "")
        usage
        exit 2
        ;;
    *)
        (($# == 2)) || { usage; exit 2; }
        broadcast_mode "$1" "$2"
        ;;
esac
