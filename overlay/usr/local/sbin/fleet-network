#!/bin/bash
set -euo pipefail

readonly ONBOARD_INTERFACE="wlan0"
readonly DEFAULT_USB_INTERFACE="${MAAV_USB_WIFI_INTERFACE:-wlan1}"
readonly AP_PROFILE="field-ap"
readonly CLIENT_PROFILE="field-client"
readonly CONFIG_FILE="${FLEET_CONFIG_FILE:-/etc/maav/fleet-network.conf}"
readonly MODE_FILE="${FLEET_MODE_FILE:-/var/lib/maav/fleet-mode}"
readonly DDS_CONFIG_DIR="${FLEET_DDS_CONFIG_DIR:-/etc/cyclonedds}"
readonly DDS_ACTIVE_CONFIG="$DDS_CONFIG_DIR/active.xml"

declare -A CONFIG=()
MASTER=""
NETWORK=""

log() {
    printf 'fleet-network: %s\n' "$*" >&2
}

read_config() {
    local key
    local line
    local value

    [[ -r "$CONFIG_FILE" ]] || {
        log "cannot read $CONFIG_FILE"
        return 1
    }

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        [[ "$line" == *=* ]] || {
            log "invalid line in $CONFIG_FILE"
            return 1
        }
        key="${line%%=*}"
        value="${line#*=}"
        [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || {
            log "invalid key in $CONFIG_FILE: $key"
            return 1
        }
        [[ ! -v "CONFIG[$key]" ]] || {
            log "duplicate key in $CONFIG_FILE: $key"
            return 1
        }
        CONFIG["$key"]="$value"
    done <"$CONFIG_FILE"
}

require_value() {
    local key="$1"

    [[ -n "${CONFIG[$key]:-}" ]] || {
        log "$key is required in $CONFIG_FILE"
        return 1
    }
}

valid_ipv4() {
    local address="$1"
    local octet
    local -a octets

    [[ "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r -a octets <<<"$address"
    for octet in "${octets[@]}"; do
        ((10#$octet >= 0 && 10#$octet <= 255)) || return 1
    done
}

validate_config() {
    local key

    read_config
    for key in FLEET_INDEX FIELD_SSID FIELD_PSK FIELD_CHANNEL FLEET_IP DEV_IDENTITY \
        DEV_PASSWORD DEV_CA_CERTIFICATE HOTSPOT_SSID HOTSPOT_PSK; do
        require_value "$key"
    done

    [[ "${CONFIG[FLEET_INDEX]}" =~ ^[0-9]{1,3}$ ]] && \
        ((10#${CONFIG[FLEET_INDEX]} <= 255)) || {
        log "FLEET_INDEX must be 0..255"
        return 1
    }

    ((${#CONFIG[FIELD_SSID]} <= 32)) || {
        log "FIELD_SSID must be at most 32 characters"
        return 1
    }
    ((${#CONFIG[FIELD_PSK]} >= 8 && ${#CONFIG[FIELD_PSK]} <= 63)) || {
        log "FIELD_PSK must contain 8 to 63 characters"
        return 1
    }
    ((${#CONFIG[HOTSPOT_PSK]} >= 8 && ${#CONFIG[HOTSPOT_PSK]} <= 63)) || {
        log "HOTSPOT_PSK must contain 8 to 63 characters"
        return 1
    }
    [[ "${CONFIG[FIELD_CHANNEL]}" =~ ^([1-9]|1[01])$ ]] || {
        log "FIELD_CHANNEL must be a 2.4 GHz channel from 1 to 11"
        return 1
    }
    valid_ipv4 "${CONFIG[FLEET_IP]}" || {
        log "FLEET_IP must be an IPv4 address"
        return 1
    }
    [[ "${CONFIG[FIELD_SSID]}" != "MWireless" && \
       "${CONFIG[FIELD_SSID]}" != "${CONFIG[HOTSPOT_SSID]}" ]] || {
        log "the field, hotspot, and MWireless SSIDs must differ"
        return 1
    }
}

read_mode() {
    local key
    local value

    MASTER=""
    NETWORK=""
    [[ -e "$MODE_FILE" ]] || return 1
    while IFS='=' read -r key value; do
        case "$key" in
            MASTER) MASTER="$value" ;;
            NETWORK) NETWORK="$value" ;;
            *) log "invalid key in $MODE_FILE: $key"; return 1 ;;
        esac
    done <"$MODE_FILE"
    [[ "$MASTER" =~ ^[0-9]{1,3}$ ]] && ((10#$MASTER <= 255)) || {
        log "MASTER in $MODE_FILE must be 0..255"
        return 1
    }
    [[ "$NETWORK" == field || "$NETWORK" == internet ]] || {
        log "NETWORK in $MODE_FILE must be field or internet"
        return 1
    }
}

connection_exists() {
    nmcli -g connection.id connection show "$1" >/dev/null 2>&1
}

disable_profile() {
    local profile="$1"

    if connection_exists "$profile"; then
        nmcli connection modify "$profile" connection.autoconnect no
        nmcli connection down "$profile" >/dev/null 2>&1 || true
    fi
}

ensure_wifi_profile() {
    local interface="$1"
    local profile="$2"
    local ssid="$3"

    if connection_exists "$profile"; then
        if [[ "$(nmcli -g connection.type connection show "$profile")" != "802-11-wireless" ]]; then
            nmcli connection delete "$profile"
        else
            return 0
        fi
    fi
    nmcli connection add type wifi ifname "$interface" con-name "$profile" ssid "$ssid"
}

set_onboard_priorities() {
    local interface
    local ssid
    local uuid

    while IFS= read -r uuid; do
        [[ -n "$uuid" ]] || continue
        ssid="$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null || true)"
        interface="$(nmcli -g connection.interface-name connection show "$uuid" 2>/dev/null || true)"
        [[ -z "$interface" || "$interface" == "$ONBOARD_INTERFACE" ]] || continue
        case "$ssid" in
            MWireless)
                nmcli connection modify "$uuid" \
                    connection.autoconnect yes \
                    connection.autoconnect-priority 300 \
                    connection.autoconnect-retries 0
                ;;
            "${CONFIG[HOTSPOT_SSID]}")
                nmcli connection modify "$uuid" \
                    connection.autoconnect yes \
                    connection.autoconnect-priority 200 \
                    connection.autoconnect-retries 0
                ;;
            "${CONFIG[FIELD_SSID]}")
                # Only configure_field_ap/client may enable a field profile.
                # This also neutralizes accidental generic DHCP profiles for
                # the field SSID.
                nmcli connection modify "$uuid" connection.autoconnect no
                ;;
            *)
                if [[ "$(nmcli -g connection.type connection show "$uuid" 2>/dev/null || true)" == \
                    "802-11-wireless" && \
                    "$(nmcli -g 802-11-wireless.mode connection show "$uuid" 2>/dev/null || true)" == \
                    "infrastructure" ]]; then
                    # Operator-saved venue Wi-Fi is a valid, lower-priority
                    # development fallback. Field profiles remain at 400.
                    nmcli connection modify "$uuid" \
                        connection.autoconnect yes \
                        connection.autoconnect-priority 100 \
                        connection.autoconnect-retries 0
                fi
                ;;
        esac
    done < <(nmcli -g UUID connection show)
}

configure_field_client() {
    ensure_wifi_profile "$ONBOARD_INTERFACE" "$CLIENT_PROFILE" "${CONFIG[FIELD_SSID]}"
    nmcli connection modify "$CLIENT_PROFILE" \
        connection.interface-name "$ONBOARD_INTERFACE" \
        connection.autoconnect yes \
        connection.autoconnect-priority 400 \
        connection.autoconnect-retries 0 \
        802-11-wireless.mode infrastructure \
        802-11-wireless.ssid "${CONFIG[FIELD_SSID]}" \
        802-11-wireless.cloned-mac-address permanent \
        802-11-wireless-security.key-mgmt wpa-psk \
        802-11-wireless-security.proto rsn \
        802-11-wireless-security.pairwise ccmp \
        802-11-wireless-security.psk "${CONFIG[FIELD_PSK]}" \
        ipv4.method manual \
        ipv4.addresses "${CONFIG[FLEET_IP]}/24" \
        ipv4.gateway "" \
        ipv4.dns "" \
        ipv4.never-default yes \
        ipv6.method disabled
}

configure_field_ap() {
    ensure_wifi_profile "$ONBOARD_INTERFACE" "$AP_PROFILE" "${CONFIG[FIELD_SSID]}"
    nmcli connection modify "$AP_PROFILE" \
        connection.interface-name "$ONBOARD_INTERFACE" \
        connection.autoconnect yes \
        connection.autoconnect-priority 400 \
        connection.autoconnect-retries 0 \
        802-11-wireless.mode ap \
        802-11-wireless.band bg \
        802-11-wireless.channel "${CONFIG[FIELD_CHANNEL]}" \
        802-11-wireless.ssid "${CONFIG[FIELD_SSID]}" \
        802-11-wireless.cloned-mac-address permanent \
        802-11-wireless-security.key-mgmt wpa-psk \
        802-11-wireless-security.proto rsn \
        802-11-wireless-security.pairwise ccmp \
        802-11-wireless-security.psk "${CONFIG[FIELD_PSK]}" \
        ipv4.method manual \
        ipv4.addresses "${CONFIG[FLEET_IP]}/24" \
        ipv4.gateway "" \
        ipv4.dns "" \
        ipv4.never-default yes \
        ipv6.method disabled
}

configure_usb_enterprise() {
    local interface="$1"
    local profile="usb-mwireless-$interface"

    ensure_wifi_profile "$interface" "$profile" "MWireless"
    nmcli connection modify "$profile" \
        connection.interface-name "$interface" \
        connection.autoconnect yes \
        connection.autoconnect-priority 300 \
        connection.autoconnect-retries 0 \
        802-11-wireless.mode infrastructure \
        802-11-wireless.ssid MWireless \
        802-11-wireless-security.key-mgmt wpa-eap \
        802-1x.eap peap \
        802-1x.identity "${CONFIG[DEV_IDENTITY]}" \
        802-1x.password "${CONFIG[DEV_PASSWORD]}" \
        802-1x.ca-cert "${CONFIG[DEV_CA_CERTIFICATE]}" \
        802-1x.phase2-auth mschapv2 \
        ipv4.method auto \
        ipv6.method auto
}

configure_usb_hotspot() {
    local interface="$1"
    local profile="usb-hotspot-$interface"

    ensure_wifi_profile "$interface" "$profile" "${CONFIG[HOTSPOT_SSID]}"
    nmcli connection modify "$profile" \
        connection.interface-name "$interface" \
        connection.autoconnect yes \
        connection.autoconnect-priority 200 \
        connection.autoconnect-retries 0 \
        802-11-wireless.mode infrastructure \
        802-11-wireless.ssid "${CONFIG[HOTSPOT_SSID]}" \
        802-11-wireless-security.key-mgmt sae \
        802-11-wireless-security.psk "${CONFIG[HOTSPOT_PSK]}" \
        ipv4.method auto \
        ipv6.method auto
}

configure_usb_radio() {
    local interface="$1"

    [[ "$interface" != "$ONBOARD_INTERFACE" && \
       "$interface" =~ ^[[:alnum:]_.-]{1,15}$ ]] || {
        log "invalid USB Wi-Fi interface: $interface"
        return 1
    }
    configure_usb_enterprise "$interface"
    configure_usb_hotspot "$interface"
    if nmcli -g GENERAL.DEVICE device show "$interface" >/dev/null 2>&1; then
        nmcli device set "$interface" managed yes autoconnect yes
    fi
}

configure_usb_radios() {
    local device
    local type

    # NetworkManager keeps profiles for absent devices. Pre-provision wlan1 so
    # an adapter inserted after this oneshot service exits can autoconnect.
    configure_usb_radio "$DEFAULT_USB_INTERFACE"

    while IFS=: read -r device type; do
        [[ "$type" == "wifi" && "$device" != "$ONBOARD_INTERFACE" && \
           "$device" != "$DEFAULT_USB_INTERFACE" ]] || continue
        configure_usb_radio "$device"
    done < <(nmcli --terse --fields DEVICE,TYPE device status)
}

configure_usb() {
    local interface="${1:-$DEFAULT_USB_INTERFACE}"

    validate_config
    configure_usb_radio "$interface"
}

set_services() {
    local master="$1"
    local network="$2"

    if [[ "$master" == yes ]] && systemctl is-enabled --quiet jarvis-web.service; then
        systemctl start --no-block jarvis-web.service
    else
        systemctl stop jarvis-web.service
    fi
    if [[ "$master" == yes && "$network" == field ]]; then
        systemctl start --no-block fleet-dhcp.service
    else
        systemctl stop fleet-dhcp.service
    fi
}

set_dds_configuration() {
    local network="$1"
    local target="$network.xml"

    [[ -r "$DDS_CONFIG_DIR/$target" ]] || {
        log "missing CycloneDDS configuration: $DDS_CONFIG_DIR/$target"
        return 1
    }
    if [[ "$(readlink "$DDS_ACTIVE_CONFIG" 2>/dev/null || true)" == "$target" ]]; then
        return
    fi
    ln -sfn "$target" "$DDS_ACTIVE_CONFIG"
    systemctl try-restart --no-block \
        xrce-dds-agent.service uwb-gateway.service
}

connect_development() {
    local ssid
    local uuid
    local visible_ssids
    local -A attempted=()

    disable_profile "$AP_PROFILE"
    disable_profile "$CLIENT_PROFILE"
    visible_ssids="$(nmcli -g SSID device wifi list ifname "$ONBOARD_INTERFACE" 2>/dev/null || true)"
    for ssid in MWireless "${CONFIG[HOTSPOT_SSID]}"; do
        grep -Fxq -- "$ssid" <<<"$visible_ssids" || continue
        while IFS= read -r uuid; do
            [[ -n "$uuid" ]] || continue
            [[ "$(nmcli -g 802-11-wireless.ssid connection show "$uuid")" == "$ssid" ]] || continue
            [[ "$(nmcli -g connection.interface-name connection show "$uuid")" == "$ONBOARD_INTERFACE" ]] || continue
            attempted["$uuid"]=1
            if nmcli --wait 15 connection up "$uuid" ifname "$ONBOARD_INTERFACE"; then
                return
            fi
        done < <(nmcli -g UUID connection show)
    done

    # Venue networks are intentionally operator-managed. Accept any saved
    # infrastructure profile bound to wlan0, but never mistake the field SSID
    # or a USB profile for an internet connection.
    while IFS= read -r uuid; do
        [[ -n "$uuid" && ! -v "attempted[$uuid]" ]] || continue
        [[ "$(nmcli -g connection.type connection show "$uuid" 2>/dev/null || true)" == \
            "802-11-wireless" ]] || continue
        [[ "$(nmcli -g connection.interface-name connection show "$uuid" 2>/dev/null || true)" == \
            "$ONBOARD_INTERFACE" ]] || continue
        [[ "$(nmcli -g 802-11-wireless.mode connection show "$uuid" 2>/dev/null || true)" == \
            "infrastructure" ]] || continue
        ssid="$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null || true)"
        [[ -n "$ssid" && "$ssid" != "${CONFIG[FIELD_SSID]}" ]] || continue
        grep -Fxq -- "$ssid" <<<"$visible_ssids" || continue
        if nmcli --wait 15 connection up "$uuid" ifname "$ONBOARD_INTERFACE"; then
            return
        fi
    done < <(nmcli -g UUID connection show)
    log "no development Wi-Fi profile connected on $ONBOARD_INTERFACE"
    return 1
}

apply_selection() {
    if [[ ! -e "$MODE_FILE" ]]; then
        connect_development
        set_dds_configuration internet
        set_services no internet
        return
    fi
    read_mode

    local is_master=no
    [[ "${CONFIG[FLEET_INDEX]}" == "$MASTER" ]] && is_master=yes
    case "$NETWORK:$is_master" in
        field:yes)
            disable_profile "$CLIENT_PROFILE"
            configure_field_ap
            nmcli connection up "$AP_PROFILE" ifname "$ONBOARD_INTERFACE"
            ;;
        field:no)
            disable_profile "$AP_PROFILE"
            configure_field_client
            nmcli connection up "$CLIENT_PROFILE" ifname "$ONBOARD_INTERFACE"
            ;;
        internet:*)
            connect_development
            ;;
    esac
    set_dds_configuration "$NETWORK"
    set_services "$is_master" "$NETWORK"
}

apply_mode() {
    validate_config
    nmcli radio wifi on
    nmcli device set "$ONBOARD_INTERFACE" managed yes autoconnect yes
    set_onboard_priorities
    configure_usb_radios
    apply_selection
}

set_mode() {
    local master="$1"
    local network="$2"
    local temporary

    validate_config
    [[ "$master" =~ ^[0-9]{1,3}$ ]] && ((10#$master <= 255)) || {
        log "master must be 0..255"
        return 1
    }
    [[ "$network" == field || "$network" == internet ]] || {
        log "network must be field or internet"
        return 1
    }
    mkdir -p "$(dirname "$MODE_FILE")"
    temporary="${MODE_FILE}.new"
    printf 'MASTER=%s\nNETWORK=%s\n' "$master" "$network" >"$temporary"
    chmod 0644 "$temporary"
    mv "$temporary" "$MODE_FILE"
    nmcli radio wifi on
    nmcli device set "$ONBOARD_INTERFACE" managed yes autoconnect yes
    apply_selection
}

stop_role() {
    disable_profile "$AP_PROFILE"
    disable_profile "$CLIENT_PROFILE"
}

reconnect_dev() {
    local active

    validate_config
    active="$(nmcli -g GENERAL.CONNECTION device show "$ONBOARD_INTERFACE")"
    if [[ "$active" == "$CLIENT_PROFILE" ]]; then
        nmcli connection down "$CLIENT_PROFILE" >/dev/null 2>&1 || true
        nmcli device connect "$ONBOARD_INTERFACE"
    else
        log "$ONBOARD_INTERFACE is using $active; no reconnect is needed"
    fi
}

case "${1:-}" in
    apply)
        apply_mode
        ;;
    check)
        validate_config
        if [[ -e "$MODE_FILE" ]]; then
            read_mode
            printf 'fleet_index=%s master=%s network=%s fleet_ip=%s field_ssid=%s\n' \
                "${CONFIG[FLEET_INDEX]}" "$MASTER" "$NETWORK" \
                "${CONFIG[FLEET_IP]}" "${CONFIG[FIELD_SSID]}"
        else
            printf 'fleet_index=%s master=none network=internet fleet_ip=%s field_ssid=%s\n' \
                "${CONFIG[FLEET_INDEX]}" "${CONFIG[FLEET_IP]}" "${CONFIG[FIELD_SSID]}"
        fi
        ;;
    is-master)
        validate_config
        read_mode
        [[ "${CONFIG[FLEET_INDEX]}" == "$MASTER" ]]
        ;;
    is-field-master)
        validate_config
        read_mode
        [[ "${CONFIG[FLEET_INDEX]}" == "$MASTER" && "$NETWORK" == field ]]
        ;;
    set-mode)
        set_mode "${2:-}" "${3:-}"
        ;;
    reconnect-dev)
        reconnect_dev
        ;;
    configure-usb)
        configure_usb "${2:-}"
        ;;
    stop)
        stop_role
        ;;
    *)
        echo "Usage: $0 {apply|check|is-master|is-field-master|set-mode MASTER field|internet|reconnect-dev|configure-usb [interface]|stop}" >&2
        exit 2
        ;;
esac
