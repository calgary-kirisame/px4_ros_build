[Unit]
Description=Direct DW1000 radio
After=local-fs.target fleet-network.service
Wants=fleet-network.service
ConditionPathExists=/dev/spidev0.0
ConditionPathExists=/etc/maav/fleet-network.conf
ConditionPathExists=/usr/local/bin/dw1000-radio

[Service]
Type=simple
User=maav
Group=maav
SupplementaryGroups=spi gpio
RuntimeDirectory=uwb
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/uwb-radio
Restart=on-failure
RestartSec=1
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=80

[Install]
WantedBy=multi-user.target
