[Unit]
Description=MAAV fleet Wi-Fi role configuration
After=NetworkManager.service
Wants=NetworkManager.service maav-fleet-dhcp.service
Before=maav-fleet-dhcp.service
ConditionPathExists=/etc/maav/fleet-network.conf
ConditionPathExists=/etc/maav/fleet-role

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maav-fleet-network apply
ExecStop=/usr/local/sbin/maav-fleet-network stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
